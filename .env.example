# Banco local (usado quando DATABASE_URL não está definida)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=central_chamados
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Banco online (Neon / Render). Se definida, tem prioridade sobre as variáveis DB_*
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Obrigatória. Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=sua_chave_secreta_aqui
JWT_EXPIRACAO_MINUTOS=60

# Cookie de sessão só via HTTPS. No Render é ativado automaticamente;
# localmente (http://127.0.0.1) deixe false
SESSION_HTTPS_ONLY=false
